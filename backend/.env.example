# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# OpenAI (required for real AI responses; mock fallback used if absent).
# CRITICAL: this key must only ever live here (backend env). Never move it
# into a VITE_ variable, the frontend, or a browser request — the browser
# never sees or needs it; all AI calls happen server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# Telephony (NOT required for browser voice demo — placeholders for future real integration)
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
